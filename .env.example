# Engine API URL (server-side only; client uses relative /api via Vite proxy or Vercel rewrite)
API_URL=http://localhost:4000

# Clerk (https://dashboard.clerk.com/~/api-keys)
# Enable User & Authentication > Name (optional) so signup shows first/last name fields.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Optional: override the Clerk Frontend API origin used by the /__clerk proxy
# middleware in src/start.ts. Defaults are derived from the publishable key.
# CLERK_FAPI_URL=https://your-instance.clerk.accounts.dev
